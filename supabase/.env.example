# Edge Function secrets. Set with:  supabase secrets set --env-file supabase/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# LLM. One key is required; AGENT_MODEL swaps the model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# 32 random bytes each: `openssl rand -hex 32`
BUYER_LINK_SECRET=
CRON_SECRET=

# Buyer email (optional; without it the buyer link is shown in the incident screen)
RESEND_API_KEY=
EMAIL_FROM=Preempt <onboarding@resend.dev>

# Base URL of the Next.js app (used in buyer links)
APP_BASE_URL=http://127.0.0.1:3000

CARRIER_FEED_MODE=simulated

# Demo controls
DEMO_ENABLED=true
DEMO_BUYER_EMAIL=buyer@example.com
# Test card for the demo checkout. If card payments are not enabled on your sandbox account,
# pass an existing { order_id, capture_id } to POST /demo/scenario instead.
DEMO_CARD_NUMBER=4111111111111111
DEMO_CARD_EXPIRY=2029-12
DEMO_CARD_CVV=123

# Optional: point the model client at a proxy or a local stand-in (include /v1)
ANTHROPIC_BASE_URL=
